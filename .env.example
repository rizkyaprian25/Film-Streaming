# ==========================================
# Konfigurasi Lingkungan Proyek CineFlow
# ==========================================

# Lingkungan runtime aplikasi (development / staging / production)
APP_ENV=development

# Base URL untuk streaming provider / API remote adapter
API_BASE_URL=https://api.cineflow.internal/v1

# Waktu tunggu request jaringan dalam milidetik
API_TIMEOUT_MS=15000

# Aktifkan fallback otomatis ke dataset mock lokal jika koneksi gagal atau offline (true / false)
ENABLE_MOCK_FALLBACK=true
